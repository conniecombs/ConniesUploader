{
  "_comment": "Shared parity fixtures. backend/core/upload_parity_test.go checks that the legacy Go path produces each 'want'; frontend/tests/test_upload_parity.py checks that the Python port and the migrated host plugins produce the same. Change both sides together.",
  "failure_messages": [
    {
      "name": "json error field",
      "reason": "upload rejected",
      "status": 400,
      "body": "{\"error\":\"image too large\"}",
      "want": "upload rejected (HTTP 400): image too large"
    },
    {
      "name": "json message field",
      "reason": "upload rejected",
      "status": 422,
      "body": "{\"message\":\"File type not allowed\",\"errors\":{}}",
      "want": "upload rejected (HTTP 422): File type not allowed"
    },
    {
      "name": "nested error object",
      "reason": "upload rejected",
      "status": 403,
      "body": "{\"error\":{\"code\":7,\"message\":\"quota exceeded\"}}",
      "want": "upload rejected (HTTP 403): quota exceeded"
    },
    {
      "name": "errors array",
      "reason": "upload rejected",
      "status": 400,
      "body": "{\"errors\":[{\"message\":\"bad dimensions\"}]}",
      "want": "upload rejected (HTTP 400): bad dimensions"
    },
    {
      "name": "data error on a status check",
      "reason": "upload failed: status check did not match",
      "status": 200,
      "body": "{\"success\":false,\"status\":400,\"data\":{\"error\":\"File is over the size limit\"}}",
      "want": "upload failed: status check did not match (HTTP 200): File is over the size limit"
    },
    {
      "name": "json without a message field is quoted whole",
      "reason": "upload response had no image link",
      "status": 200,
      "body": "{\"show_url\":\"\",\"th_url\":\"\"}",
      "want": "upload response had no image link (HTTP 200): {\"show_url\":\"\",\"th_url\":\"\"}"
    },
    {
      "name": "non-string error field is skipped",
      "reason": "upload rejected",
      "status": 500,
      "body": "{\"error\":true,\"msg\":\"  try   again\\nlater \"}",
      "want": "upload rejected (HTTP 500): try again later"
    },
    {
      "name": "html page without scripts",
      "reason": "upload rejected",
      "status": 404,
      "body": "<html><head><title>x</title><script>var a = 1;</script></head><body><h1>Not   Found</h1></body></html>",
      "want": "upload rejected (HTTP 404): Not Found"
    },
    {
      "name": "nginx error page",
      "reason": "upload rejected",
      "status": 413,
      "body": "<html>\r\n<head><title>413 Request Entity Too Large</title></head>\r\n<body>\r\n<center><h1>413 Request Entity Too Large</h1></center>\r\n<hr><center>nginx</center>\r\n</body>\r\n</html>\r\n",
      "want": "upload rejected (HTTP 413): 413 Request Entity Too Large nginx"
    },
    {
      "name": "html body scripts styles and comments are not text",
      "reason": "upload rejected",
      "status": 500,
      "body": "<html><body><style>.a{color:red}</style><script>alert('x')</script><!-- hidden --><noscript>enable js</noscript><p>Server &amp; database <b>busy</b>.</p></body></html>",
      "want": "upload rejected (HTTP 500): Server & database busy ."
    },
    {
      "name": "html with only a title",
      "reason": "upload rejected",
      "status": 503,
      "body": "<html><head><title>Service Unavailable</title></head><body><script>x()</script></body></html>",
      "want": "upload rejected (HTTP 503): Service Unavailable"
    },
    {
      "name": "html fragment",
      "reason": "upload response had no image link",
      "status": 200,
      "body": "<html><body><b>Upload failed: File type not allowed</b></body></html>",
      "want": "upload response had no image link (HTTP 200): Upload failed: File type not allowed"
    },
    {
      "name": "not json",
      "reason": "upload response was not valid JSON",
      "status": 200,
      "body": "<html><body>Service Unavailable</body></html>",
      "want": "upload response was not valid JSON (HTTP 200): Service Unavailable"
    },
    {
      "name": "plain text with a credential",
      "reason": "upload rejected",
      "status": 401,
      "body": "Bad key s3cr3t-api-key for user",
      "secrets": ["s3cr3t-api-key", "abc"],
      "want": "upload rejected (HTTP 401): Bad key [redacted] for user"
    },
    {
      "name": "a secret inside another is redacted whole",
      "reason": "upload rejected",
      "status": 403,
      "body": "{\"message\":\"token tok-1234-extra rejected; tok-1234 too\"}",
      "secrets": ["tok-1234", "tok-1234-extra"],
      "want": "upload rejected (HTTP 403): token [redacted] rejected; [redacted] too"
    },
    {
      "name": "empty body",
      "reason": "upload rejected",
      "status": 502,
      "body": "   ",
      "want": "upload rejected (HTTP 502)"
    },
    {
      "name": "json array",
      "reason": "upload rejected",
      "status": 400,
      "body": "[\"bad\", \"request\"]",
      "want": "upload rejected (HTTP 400): [\"bad\", \"request\"]"
    },
    {
      "name": "long text is cut at 200 characters",
      "reason": "upload rejected",
      "status": 400,
      "body": "ÄÖÜ 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789",
      "want": "upload rejected (HTTP 400): ÄÖÜ 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789 012345678…"
    },
    {
      "name": "control characters become spaces",
      "reason": "upload rejected",
      "status": 400,
      "body": "line one\u0000line\ttwo\u0007end",
      "want": "upload rejected (HTTP 400): line one line two end"
    },
    {
      "name": "a credential echoed url-encoded is redacted",
      "reason": "login failed",
      "status": 403,
      "body": "<html><body><h1>Request blocked</h1><pre>op=login&login=connie&password=P%40ss%2Fw0rd%7B%C3%A9%7D</pre></body></html>",
      "secrets": ["P@ss/w0rd{é}", "connie"],
      "want": "login failed (HTTP 403): Request blocked op=login&login=[redacted]&password=[redacted]"
    },
    {
      "name": "url-encoded with lowercase escapes and plus for space",
      "reason": "login failed",
      "status": 400,
      "body": "rejected: pw=my+pass%20word&next=P%40ss%2fw0rd%7b%c3%a9%7d",
      "secrets": ["P@ss/w0rd{é}", "my pass word"],
      "want": "login failed (HTTP 400): rejected: pw=[redacted]&next=[redacted]"
    },
    {
      "name": "a credential echoed json-escaped is redacted",
      "reason": "login failed",
      "status": 400,
      "body": "{\"ok\":false,\"echo\":{\"password\":\"P@ss\\/w0rd{\\u00e9}\",\"user\":\"P@ss\\/w0rd{é}\",\"emoji\":\"pass\\ud83d\\ude00word\"}}",
      "secrets": ["P@ss/w0rd{é}", "pass😀word"],
      "want": "login failed (HTTP 400): {\"ok\":false,\"echo\":{\"password\":\"[redacted]\",\"user\":\"[redacted]\",\"emoji\":\"[redacted]\"}}"
    },
    {
      "name": "a credential echoed with html entities is redacted",
      "reason": "login failed",
      "status": 401,
      "body": "Invalid password P@ss/w0rd{&eacute;} or P&#64;ss&#x2F;w0rd&#123;&#233;&#X7d;",
      "secrets": ["P@ss/w0rd{é}"],
      "want": "login failed (HTTP 401): Invalid password [redacted] or [redacted]"
    },
    {
      "name": "escapes inside a longer secret are redacted whole",
      "reason": "upload rejected",
      "status": 400,
      "body": "session tok%2D1234%2Dextra expired",
      "secrets": ["tok-1234", "tok-1234-extra"],
      "want": "upload rejected (HTTP 400): session [redacted] expired"
    },
    {
      "name": "half of an entity that stands for two characters is not redacted",
      "reason": "upload rejected",
      "status": 400,
      "body": "code abc&NotEqualTilde; here",
      "secrets": ["abc≂"],
      "want": "upload rejected (HTTP 400): code abc&NotEqualTilde; here"
    },
    {
      "name": "a secret under four characters is never redacted, escaped or not",
      "reason": "login failed",
      "status": 401,
      "body": "Wrong PIN abc, a%62c or &#97;bc",
      "secrets": ["abc"],
      "want": "login failed (HTTP 401): Wrong PIN abc, a%62c or &#97;bc"
    },
    {
      "name": "the minimum length counts characters, not bytes",
      "reason": "login failed",
      "status": 401,
      "body": "Wrong PIN éé",
      "secrets": ["éé"],
      "want": "login failed (HTTP 401): Wrong PIN éé"
    }
  ],
  "redactions": [
    {
      "name": "upper-case unicode escapes",
      "text": "{\"pw\":\"P@ss\\/w0rd{\\u00E9}\"}",
      "secrets": ["P@ss/w0rd{é}"],
      "want": "{\"pw\":\"[redacted]\"}"
    },
    {
      "name": "an escaped backslash is no unicode escape",
      "text": "name \\\\u00e9tienne",
      "secrets": ["étienne"],
      "want": "name \\\\u00e9tienne"
    },
    {
      "name": "a lone surrogate escape stands for no character",
      "text": "x\\ud83dword",
      "secrets": ["�word"],
      "want": "x\\ud83dword"
    },
    {
      "name": "a percent sign without two hex digits stays",
      "text": "100%zz off for P%40ss%2Fw0rd%7B%C3%A9%7D",
      "secrets": ["P@ss/w0rd{é}"],
      "want": "100%zz off for [redacted]"
    },
    {
      "name": "html special characters in a secret",
      "text": "user a&amp;b&lt;c&gt;d&quot; refused",
      "secrets": ["a&b<c>d\""],
      "want": "user [redacted] refused"
    },
    {
      "name": "references to no character stay",
      "text": "a&#0;bcd &#xD800;wxyz &#x110000;",
      "secrets": ["abcd", "�wxyz"],
      "want": "a&#0;bcd &#xD800;wxyz &#x110000;"
    },
    {
      "name": "secrets of the same length go in a fixed order",
      "text": "abc%64efghi",
      "secrets": ["defghi", "abcdef"],
      "want": "[redacted]ghi"
    }
  ],
