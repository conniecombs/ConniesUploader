{
  "_comment": "TurboImageHost parity fixtures. backend/core/turbo_upload_parity_test.go checks that the legacy Go path (legacy.response_parser and legacy.resolve_spec, as TurboPlugin.build_http_request builds them) gives each 'want'; frontend/tests/test_turbo_upload_parity.py checks that the plugin's Python parser gives the same (python_error where the Python path quotes the host's message). Each case uploads its files one after another, each resolved right after its own upload; 'upload' answers every upload unless 'uploads' (by upload order) says otherwise; 'pages' are the result page as served to successive requests (the last repeats); 'result_url' is the page every request must ask for, and 'page_requests' how many there are. Change both sides together.",
  "legacy": {
    "response_parser": {
      "type": "json",
      "url_path": "newUrl",
      "thumb_path": "",
      "status_path": "success",
      "success_value": "true",
      "url_template": "https://www.turboimagehost.com/p/{id}/{filename}.html"
    },
    "resolve_spec": {
      "result_url": "{url}",
      "poll_delays_ms": [
        500,
        1000,
        2000,
        3000,
        5000,
        5000
      ],
      "link_extractor": "(?is)\\[url=(?P<image_url>https?://[^\\]]+?/p/[0-9]+/(?P<filename>[^/\\]]+?)\\.html)\\]\\s*\\[img\\](?P<thumb_url>https?://[^\\]]+?)\\[/img\\]\\s*\\[/url\\]",
      "gallery_extractor": "input#imgCodeGG",
      "file_match_mode": "filename"
    }
  },
